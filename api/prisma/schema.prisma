generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String?
  role      Role    @default(PATRON)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional stretch: a user can write many reviews
  reviews   Review[]
}

model Genre {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books     Book[]
}

model Book {
  id          Int     @id @default(autoincrement())
  title       String
  author      String
  isbn        String? @unique
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genreId     Int
  genre       Genre   @relation(fields: [genreId], references: [id])

  // Optional stretch: reviews for this book
  reviews     Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1–5, for example
  comment   String?
  createdAt DateTime @default(now())

  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id])

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}
